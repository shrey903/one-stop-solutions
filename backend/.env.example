# Copy this file to ".env" in the same folder and fill in real values.

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=one_stop_solutions

# ---- SMTP (Gmail example — use an App Password, not your login password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourbusiness@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=yourbusiness@gmail.com
EMAIL_TO=kinjalshah@example.com

# ---- WhatsApp Cloud API (Meta for Developers) ----
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_sender_phone_number_id
WHATSAPP_TO_NUMBER=919998883276

# ---- App ----
ALLOWED_ORIGINS=*
